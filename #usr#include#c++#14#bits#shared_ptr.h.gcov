        -:   66:  /// Write the stored pointer to an ostream.
        -:   67:  /// @relates shared_ptr
        -:   68:  template<typename _Ch, typename _Tr, typename _Tp, _Lock_policy _Lp>
        -:   69:    inline std::basic_ostream<_Ch, _Tr>&
