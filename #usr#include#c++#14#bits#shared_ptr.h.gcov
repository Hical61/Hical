        -:   71:	       const __shared_ptr<_Tp, _Lp>& __p)
        -:   72:    {
        -:   73:      __os << __p.get();
        -:   74:      return __os;
        -:   75:    }
        -:   76:
        -:   77:  template<typename _Del, typename _Tp, _Lock_policy _Lp>
        -:   78:    inline _Del*
        -:   79:    get_deleter(const __shared_ptr<_Tp, _Lp>& __p) noexcept
        -:   80:    {
        -:   81:#if __cpp_rtti
        -:   82:      return static_cast<_Del*>(__p._M_get_deleter(typeid(_Del)));
        -:   83:#else
        -:   84:      return 0;
        -:   85:#endif
        -:   86:    }
