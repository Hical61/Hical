        -:  568:
        -:  569:// ============ C++20 回退宏 ============
        -:  570:
        -:  571:/**
        -:  572: * @brief 标注结构体字段用于自动 JSON 序列化（C++20 回退方案）
        -:  573: * 基本用法（字段名 = JSON key，全部可选）：
        -:  574: * ```cpp
        -:  575: * struct UserDTO
        -:  576: * {
        -:  577: *     std::string name;
        -:  578: *     int age;
        -:  579: *     HICAL_JSON(UserDTO, name, age)
        -:  580: * };
        -:  581: * ```
        -:  582: * 高级用法（装饰器混写）：
        -:  583: * ```cpp
        -:  584: * struct ApiResponse
        -:  585: * {
        -:  586: *     std::string requestId;
        -:  587: *     int statusCode;
        -:  588: *     std::string message;
        -:  589: *     std::string traceId;
        -:  590: *     HICAL_JSON(ApiResponse,
        -:  591: *         REQUIRED_ALIAS(requestId, "request_id"),
        -:  592: *         REQUIRED(statusCode),
        -:  593: *         ALIAS(message, "status_message"),
        -:  594: *         HICAL_IGNORE(traceId))
        -:  595: * };
        -:  596: * ```
        -:  597: * 装饰器：
        -:  598: *   ALIAS(field, "json_key")          - 自定义 JSON key
        -:  599: *   REQUIRED(field)                   - 反序列化时必需
        -:  600: *   REQUIRED_ALIAS(field, "json_key") - 必需 + 自定义 key
        -:  601: *   HICAL_IGNORE(field)               - 序列化/反序列化均跳过
        -:  602: * 当 C++26 反射可用时，此宏及所有装饰器为空操作。
        -:  603: */
        -:  604:#if !HICAL_HAS_REFLECTION
        -:  605:
        -:  606:	// ---- 装饰器宏（展开为括号元组，对 FOR_EACH 仍是单个 token）----
        -:  607:
        -:  608:	// NOLINTBEGIN(cppcoreguidelines-macro-usage)
        -:  609:	#define ALIAS(field, alias) (hical_alias_, field, alias)
        -:  610:	#define REQUIRED(field) (hical_required_, field)
        -:  611:	#define REQUIRED_ALIAS(field, alias) (hical_required_alias_, field, alias)
        -:  612:
        -:  613:	#define HICAL_IGNORE(field) (hical_ignore_, field)
        -:  614:
        -:  615:// ---- IS_PAREN 检测（区分裸字段名 vs 括号装饰器）----
        -:  616:
        -:  617:	#define HICAL_IS_PAREN_PROBE_(...) ~, 1,
        -:  618:	#define HICAL_IS_PAREN_CHECK_(...) HICAL_IS_PAREN_CHECK_N_(__VA_ARGS__, 0)
        -:  619:	#define HICAL_IS_PAREN_CHECK_N_(x, n, ...) n
        -:  620:	#define HICAL_IS_PAREN_(x) HICAL_IS_PAREN_CHECK_(HICAL_IS_PAREN_PROBE_ x)
        -:  621:
        -:  622:// ---- Token 拼接辅助 ----
        -:  623:
        -:  624:	#define HICAL_JSON_PASTE2_(a, b) a##b
        -:  625:	#define HICAL_JSON_PASTE_(a, b) HICAL_JSON_PASTE2_(a, b)
        -:  626:
        -:  627:// ---- 叶子宏分派 ----
        -:  628:
        -:  629:	#define HICAL_JSON_FIELD_(T, arg) HICAL_JSON_PASTE_(HICAL_JSON_LEAF_, HICAL_IS_PAREN_(arg))(T, arg)
        -:  630:
        -:  631:	// 字段存在性校验 + makeField 构造（公共骨架）
        -:  632:	#define HICAL_JSON_MAKE_FIELD_(T, field, ...)                                                          \
        -:  633:		(                                                                                                  \
        -:  634:			[]()                                                                                           \
        -:  635:			{                                                                                              \
        -:  636:				static_assert(                                                                             \
        -:  637:					requires { std::declval<T>().field; },                                                 \
        -:  638:					"HICAL_JSON: field '" #field "' does not exist or is not publicly accessible in " #T); \
        -:  639:				return ::hical::meta::detail::makeField<T>(__VA_ARGS__);                                   \
        -:  640:			}())
        -:  641:
        -:  642:	// 裸字段：name → makeField("name", &T::name)
        -:  643:	#define HICAL_JSON_LEAF_0(T, field) HICAL_JSON_MAKE_FIELD_(T, field, #field, &T::field)
        -:  644:
        -:  645:	// 括号装饰 → 解包括号 → 提取 tag → 分派到对应 TAG 处理器
        -:  646:	// HICAL_JSON_DEPAREN_ 剥离外层括号：(a, b, c) → a, b, c
        -:  647:	#define HICAL_JSON_DEPAREN_(...) __VA_ARGS__
        -:  648:	#define HICAL_JSON_LEAF_1(T, tagged) HICAL_JSON_UNWRAP_(T, HICAL_JSON_DEPAREN_ tagged)
        -:  649:	#define HICAL_JSON_UNWRAP_(T, ...) HICAL_JSON_TAG_DISPATCH_(T, __VA_ARGS__)
        -:  650:	#define HICAL_JSON_TAG_DISPATCH_(T, tag, ...) HICAL_JSON_PASTE_(HICAL_JSON_TAG_, tag)(T, __VA_ARGS__)
        -:  651:
        -:  652:// ---- Tag 处理器 ----
        -:  653:
        -:  654:	#define HICAL_JSON_TAG_hical_alias_(T, field, alias) HICAL_JSON_MAKE_FIELD_(T, field, alias, &T::field)
        -:  655:	#define HICAL_JSON_TAG_hical_required_(T, field) HICAL_JSON_MAKE_FIELD_(T, field, #field, &T::field, true, false)
        -:  656:	#define HICAL_JSON_TAG_hical_required_alias_(T, field, alias) \
        -:  657:		HICAL_JSON_MAKE_FIELD_(T, field, alias, &T::field, true, false)
        -:  658:	#define HICAL_JSON_TAG_hical_ignore_(T, field) HICAL_JSON_MAKE_FIELD_(T, field, #field, &T::field, false, true)
        -:  659:
        -:  660:// ---- __VA_OPT__ 递归展开（无字段数量限制）----
        -:  661:
        -:  662:	#define HICAL_JSON_PARENS_ ()
        -:  663:
        -:  664:	#define HICAL_JSON_FOR_EACH_(macro, T, a, ...) \
        -:  665:		macro(T, a) __VA_OPT__(, HICAL_JSON_FE_AGAIN_ HICAL_JSON_PARENS_(macro, T, __VA_ARGS__))
        -:  666:
        -:  667:	#define HICAL_JSON_FE_AGAIN_() HICAL_JSON_FOR_EACH_
        -:  668:
        -:  669:	// 多层 EXPAND 解锁递归深度（支持最多 243 字段）
        -:  670:	#define HICAL_JSON_EXPAND_(...) HICAL_JSON_EXP4_(HICAL_JSON_EXP4_(__VA_ARGS__))
        -:  671:	#define HICAL_JSON_EXP4_(...) HICAL_JSON_EXP3_(HICAL_JSON_EXP3_(__VA_ARGS__))
        -:  672:	#define HICAL_JSON_EXP3_(...) HICAL_JSON_EXP2_(HICAL_JSON_EXP2_(__VA_ARGS__))
        -:  673:	#define HICAL_JSON_EXP2_(...) HICAL_JSON_EXP1_(HICAL_JSON_EXP1_(__VA_ARGS__))
        -:  674:	#define HICAL_JSON_EXP1_(...) __VA_ARGS__
        -:  675:
        -:  676:// ---- 入口宏 ----
        -:  677:
        -:  678:	#define HICAL_JSON(Type, ...)                                                                                \
        -:  679:		static const auto& hicalJsonFields()                                                                     \
        -:  680:		{                                                                                                        \
        -:  681:			static const auto fields =                                                                           \
        -:  682:				std::make_tuple(HICAL_JSON_EXPAND_(HICAL_JSON_FOR_EACH_(HICAL_JSON_FIELD_, Type, __VA_ARGS__))); \
        -:  683:			return fields;                                                                                       \
        -:  684:		}
        -:  685:
        -:  686:// NOLINTEND(cppcoreguidelines-macro-usage)
        -:  687:
        -:  688:#else
        -:  689:// C++26 反射模式下，所有宏为空操作
        -:  690:	#define HICAL_JSON(Type, ...)
        -:  691:	#define ALIAS(field, alias)
        -:  692:	#define REQUIRED(field)
        -:  693:	#define REQUIRED_ALIAS(field, alias)
        -:  694:	#define HICAL_IGNORE(field)
        -:  695:#endif
