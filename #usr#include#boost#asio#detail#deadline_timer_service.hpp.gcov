        -:  277:  // Helper function to wait given a duration type. The duration type should
        -:  278:  // either be of type boost::posix_time::time_duration, or implement the
        -:  279:  // required subset of its interface.
        -:  280:  template <typename Duration>
        -:  281:  void do_wait(const Duration& timeout, boost::system::error_code& ec)
        -:  282:  {
        -:  283:#if defined(BOOST_ASIO_WINDOWS_RUNTIME)
        -:  284:    std::this_thread::sleep_for(
        -:  285:        std::chrono::seconds(timeout.total_seconds())
        -:  286:        + std::chrono::microseconds(timeout.total_microseconds()));
        -:  287:    ec = boost::system::error_code();
        -:  288:#else // defined(BOOST_ASIO_WINDOWS_RUNTIME)
        -:  289:    ::timeval tv;
        -:  290:    tv.tv_sec = timeout.total_seconds();
        -:  291:    tv.tv_usec = timeout.total_microseconds() % 1000000;
        -:  292:    socket_ops::select(0, 0, 0, 0, &tv, ec);
        -:  293:#endif // defined(BOOST_ASIO_WINDOWS_RUNTIME)
        -:  294:  }
