# Hical 生产部署环境变量示例
# 复制为 .env 后修改实际值

# ---- 服务器 ----
PORT=8080
IO_THREADS=4

# ---- 日志 ----
LOG_LEVEL=INFO          # TRACE / DEBUG / INFO / WARN / ERROR
LOG_FORMAT=json         # json / text
LOG_OUTPUT=stderr       # stderr / file
LOG_DIR=/var/log/hical

# ---- 数据库 ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=hical
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=hical_prod
DB_MIN_CONNS=2
DB_MAX_CONNS=16

# ---- CORS ----
CORS_ORIGIN=*
