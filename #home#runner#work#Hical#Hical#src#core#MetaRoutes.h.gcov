        -:  159:			template for (constexpr auto attr : attrs)
        -:  160:			{
        -:  161:				if constexpr (std::meta::identifier_of(attr) == "hical::route")
        -:  162:				{
        -:  163:					constexpr auto args = std::meta::attribute_arguments_of(attr);
        -:  164:					constexpr auto path = std::meta::extract<const char*>(args[0]);
        -:  165:					constexpr auto methodStr = std::meta::extract<const char*>(args[1]);
        -:  166:					auto method = stringToHttpMethod(methodStr);
        -:  167:
        -:  168:					router.route(method,
        -:  169:								 path,
        -:  170:								 [&handler](const HttpRequest& req) -> Awaitable<HttpResponse>
        -:  171:								 {
        -:  172:									 if constexpr (std::is_same_v<decltype(handler.[:fn:](req)), HttpResponse>)
        -:  173:									 {
        -:  174:										 co_return handler.[:fn:](req);
        -:  175:									 }
        -:  176:									 else
        -:  177:									 {
        -:  178:										 co_return co_await handler.[:fn:](req);
        -:  179:									 }
        -:  180:								 });
        -:  181:				}
        -:  182:			}
        -:  183:		}
        -:  184:	}
        -:  185:
        -:  186:#endif // HICAL_HAS_REFLECTION
        -:  187:
        -:  188:} // namespace hical::meta
        -:  189:
        -:  190:// ============ C++20 回退宏 ============
        -:  191:
        -:  192:#if !HICAL_HAS_REFLECTION
        -:  193:
        -:  194:/**
        -:  195: * @brief 标注单个路由处理器（C++20 回退方案）
        -:  196: * @param method HTTP 方法（Get, Post, Put, Delete 等）
        -:  197: * @param path   路由路径
        -:  198: * @param func   成员函数名
        -:  199: */
        -:  200:	#define HICAL_HANDLER(method, path, func) \
        -:  201:		static constexpr ::hical::meta::RouteInfo hicalRouteInfo_##func {::hical::HttpMethod::h##method, path, #func};
        -:  202:
        -:  203:/**
        -:  204: * @brief 收集所有路由（C++20 回退方案）
        -:  205: * 第一个参数为 Handler 类型名，后续参数为成员函数名。
        -:  206: * 用法：HICAL_ROUTES(MyHandler, listUsers, getUser)
        -:  207: */
        -:  208:	#define HICAL_ROUTES(Type, ...)                                                                  \
        -:  209:		static auto hicalRouteTable()                                                                \
        -:  210:		{                                                                                            \
        -:  211:			return std::make_tuple(HICAL_ROUTES_EXPAND_(HICAL_ROUTES_FOR_EACH_(Type, __VA_ARGS__))); \
        -:  212:		}
        -:  213:
        -:  214:	// 生成单个 registrar
        -:  215:	#define HICAL_ROUTE_REG_(T, func) ::hical::meta::detail::makeRegistrar<T>(T::hicalRouteInfo_##func, &T::func)
        -:  216:
        -:  217:// ---- __VA_OPT__ 递归展开 ----
        -:  218:
        -:  219:	#define HICAL_ROUTES_PARENS_ ()
        -:  220:
        -:  221:	#define HICAL_ROUTES_FOR_EACH_(T, a, ...) \
        -:  222:		HICAL_ROUTE_REG_(T, a) __VA_OPT__(, HICAL_ROUTES_FE_AGAIN_ HICAL_ROUTES_PARENS_(T, __VA_ARGS__))
        -:  223:
        -:  224:	#define HICAL_ROUTES_FE_AGAIN_() HICAL_ROUTES_FOR_EACH_
        -:  225:
        -:  226:	// 多层 EXPAND 解锁递归深度（支持最多 243 个路由）
        -:  227:	#define HICAL_ROUTES_EXPAND_(...) HICAL_ROUTES_EXP4_(HICAL_ROUTES_EXP4_(__VA_ARGS__))
        -:  228:	#define HICAL_ROUTES_EXP4_(...) HICAL_ROUTES_EXP3_(HICAL_ROUTES_EXP3_(__VA_ARGS__))
        -:  229:	#define HICAL_ROUTES_EXP3_(...) HICAL_ROUTES_EXP2_(HICAL_ROUTES_EXP2_(__VA_ARGS__))
        -:  230:	#define HICAL_ROUTES_EXP2_(...) HICAL_ROUTES_EXP1_(HICAL_ROUTES_EXP1_(__VA_ARGS__))
        -:  231:	#define HICAL_ROUTES_EXP1_(...) __VA_ARGS__
        -:  232:
        -:  233:#else
        -:  234:	#define HICAL_HANDLER(method, path, func)
        -:  235:	#define HICAL_ROUTES(Type, ...)
        -:  236:#endif
