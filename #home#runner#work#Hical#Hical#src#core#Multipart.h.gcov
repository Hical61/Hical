        -:   36:	/**
        -:   37:	 * @brief multipart/form-data 解析器
        -:   38:	 * 按照 RFC 7578 解析 Content-Type: multipart/form-data 请求体。
        -:   39:	 * 用法（通过 HttpRequest 访问）：
        -:   40:	 * ```cpp
        -:   41:	 * auto parts = hical::MultipartParser::parse(req);
        -:   42:	 * if (parts) {
        -:   43:	 *     for (const auto& part : *parts) {
        -:   44:	 *         if (part.isFile()) {
        -:   45:	 *             // 处理上传文件
        -:   46:	 *         } else {
        -:   47:	 *             // 处理表单字段
        -:   48:	 *         }
        -:   49:	 *     }
        -:   50:	 * }
        -:   51:	 * ```
        -:   52:	 * 也可以直接用辅助方法：
        -:   53:	 * ```cpp
        -:   54:	 * auto file  = hical::MultipartParser::getFile(req, "avatar");
        -:   55:	 * auto field = hical::MultipartParser::getField(req, "username");
        -:   56:	 * ```
        -:   57:	 */
        -:   58:	class MultipartParser
        -:   59:	{
        -:   60:	public:
        -:   61:		/**
        -:   62:		 * @brief 解析 multipart/form-data 请求体
        -:   63:		 * @param req HTTP 请求
        -:   64:		 * @return 解析成功返回 Part 列表，失败返回 nullopt
        -:   65:		 * 失败情况：Content-Type 不是 multipart/form-data、boundary 缺失、格式错误。
        -:   66:		 */
        -:   67:		static std::optional<std::vector<MultipartPart>> parse(const HttpRequest& req);
        -:   68:
        -:   69:		/**
        -:   70:		 * @brief 获取指定名称的文件上传 Part
        -:   71:		 * @param req HTTP 请求
        -:   72:		 * @param fieldName 表单字段名
        -:   73:		 * @return 找到返回 MultipartPart（isFile() == true），否则 nullopt
        -:   74:		 * @note 多次调用 getFile/getField 建议先调用 parse() 再用下方重载，避免重复解析
        -:   75:		 */
        -:   76:		static std::optional<MultipartPart> getFile(const HttpRequest& req, const std::string& fieldName);
        -:   77:
        -:   78:		/**
        -:   79:		 * @brief 从已解析的 parts 中查找文件 Part（避免重复解析）
        -:   80:		 * @param parts 已通过 parse() 获取的 Part 列表
        -:   81:		 * @param fieldName 表单字段名
        -:   82:		 * @return 找到返回 MultipartPart，否则 nullopt
        -:   83:		 */
        -:   84:		static std::optional<MultipartPart> getFile(const std::vector<MultipartPart>& parts,
        -:   85:													const std::string& fieldName);
        -:   86:
        -:   87:		/**
        -:   88:		 * @brief 获取指定名称的表单文本字段值
        -:   89:		 * @param req HTTP 请求
        -:   90:		 * @param fieldName 表单字段名
        -:   91:		 * @return 找到返回字段值，否则 nullopt
        -:   92:		 * @note 多次调用 getFile/getField 建议先调用 parse() 再用下方重载，避免重复解析
        -:   93:		 */
        -:   94:		static std::optional<std::string> getField(const HttpRequest& req, const std::string& fieldName);
        -:   95:
        -:   96:		/**
        -:   97:		 * @brief 从已解析的 parts 中查找文本字段（避免重复解析）
        -:   98:		 * @param parts 已通过 parse() 获取的 Part 列表
        -:   99:		 * @param fieldName 表单字段名
        -:  100:		 * @return 找到返回字段值，否则 nullopt
        -:  101:		 */
        -:  102:		static std::optional<std::string> getField(const std::vector<MultipartPart>& parts,
        -:  103:												   const std::string& fieldName);
