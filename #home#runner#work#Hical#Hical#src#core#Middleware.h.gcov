        -:   98:		std::atomic<int64_t> totalTimeUs {0};                                 // 微秒
        -:   99:		std::atomic<int64_t> maxTimeUs {0};                                   // 微秒
        -:  100:		std::atomic<int64_t> minTimeUs {std::numeric_limits<int64_t>::max()}; // 微秒
        -:  101:
        -:  102:		double avgTimeMs() const
        -:  103:		{
        -:  104:			auto count = callCount.load(std::memory_order_relaxed);
        -:  105:			return count > 0 ? static_cast<double>(totalTimeUs.load(std::memory_order_relaxed)) / (1000.0 * count)
