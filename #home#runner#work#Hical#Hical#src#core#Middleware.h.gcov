        -:  115:			// 更新最大值（CAS）
        -:  116:			auto curMax = maxTimeUs.load(std::memory_order_relaxed);
        -:  117:			while (us > curMax && !maxTimeUs.compare_exchange_weak(curMax, us, std::memory_order_relaxed))
        -:  118:			{
        -:  119:			}
        -:  120:
        -:  121:			// 更新最小值（CAS）
        -:  122:			auto curMin = minTimeUs.load(std::memory_order_relaxed);
        -:  123:			while (us < curMin && !minTimeUs.compare_exchange_weak(curMin, us, std::memory_order_relaxed))
        -:  124:			{
        -:  125:			}
        -:  126:		}
        -:  127:	};
