        -:   91:	 * 使用 int64_t 微秒存储，保证所有平台上 atomic<int64_t> 都是 lock-free。
        -:   92:	 * 仅在 HICAL_ENABLE_MIDDLEWARE_PROFILING 编译选项开启时可用。
        -:   93:	 */
        -:   94:	struct MiddlewareTimingStats
        -:   95:	{
        -:   96:		std::string name;
