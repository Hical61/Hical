{
    "name": "hical",
    "version": "2.7.2",
    "dependencies": [
        "boost-asio",
        "boost-system",
        "boost-json",
        "openssl",
        "zlib",
        "gtest"
    ],
    "features": {
        "http-client": {
            "description": "Coroutine HTTP client (requires Boost.Asio >= 1.86)",
            "dependencies": [
                "boost-asio"
            ]
        },
        "http2": {
            "description": "TLS HTTP/2 support (requires nghttp2 >= 1.70 and < 2)",
            "dependencies": [
                "nghttp2"
            ]
        },
        "database": {
            "description": "Database middleware with MySQL support (requires Boost.MySQL)",
            "dependencies": [
                "boost-mysql",
                "boost-charconv"
            ]
        },
        "mimalloc": {
            "description": "Use mimalloc as PMR upstream allocator",
            "dependencies": [
                "mimalloc"
            ]
        }
    }
}
