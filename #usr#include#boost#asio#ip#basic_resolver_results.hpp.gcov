        -:  298:      const basic_resolver_results& b)
        -:  299:  {
        -:  300:    return !a.equal(b);
        -:  301:  }
        -:  302:
        -:  303:private:
        -:  304:  typedef std::vector<basic_resolver_entry<InternetProtocol> > values_type;
        -:  305:};
