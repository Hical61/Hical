FROM ubuntu:24.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make g++ python3 python3-pip pipx ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

# 安装 Conan 2
RUN pipx install conan && pipx ensurepath
ENV PATH="/root/.local/bin:${PATH}"

# 初始化 Conan 默认 profile
RUN conan profile detect

# 下载 hical v2.5.2 Conan 源码包并创建本地 Conan 包（Boost 静态链接）
RUN wget -q https://github.com/Hical61/Hical/releases/download/v2.5.2/hical-2.5.2-conan-src.tar.gz \
    -O /tmp/hical-src.tar.gz \
    && mkdir -p /tmp/hical-src && tar xzf /tmp/hical-src.tar.gz -C /tmp/hical-src --strip-components=1 \
    && cd /tmp/hical-src && conan create . --build=missing -s build_type=Release -s compiler.cppstd=20 \
       -o "boost/*:shared=False" \
    && rm -rf /tmp/hical-src /tmp/hical-src.tar.gz

WORKDIR /src
COPY main.cpp CMakeLists.txt conanfile.txt ./

# 安装依赖（hical 包已在本地 Conan cache 中）
RUN conan install . --build=missing -s build_type=Release -s compiler.cppstd=20

# 构建 bench_server 并 strip
RUN cmake --preset conan-release \
    && cmake --build --preset conan-release -j$(nproc) \
    && strip /src/bench_server

# --- 运行阶段 ---
FROM ubuntu:24.04
COPY --from=builder /src/bench_server /server
EXPOSE 8080
CMD ["/server"]
