        -:   75:/// Holds a buffer that can be modified.
        -:   76:/**
        -:   77: * The mutable_buffer class provides a safe representation of a buffer that can
        -:   78: * be modified. It does not own the underlying data, and so is cheap to copy or
        -:   79: * assign.
        -:   80: *
        -:   81: * @par Accessing Buffer Contents
        -:   82: *
        -:   83: * The contents of a buffer may be accessed using the @c data() and @c size()
        -:   84: * member functions:
        -:   85: *
        -:   86: * @code boost::asio::mutable_buffer b1 = ...;
        -:   87: * std::size_t s1 = b1.size();
        -:   88: * unsigned char* p1 = static_cast<unsigned char*>(b1.data());
        -:   89: * @endcode
        -:   90: *
        -:   91: * The @c data() member function permits violations of type safety, so uses of
        -:   92: * it in application code should be carefully considered.
        -:   93: */
        -:   94:class mutable_buffer
        -:   95:{
        -:   96:public:
        -:   97:  /// Construct an empty buffer.
        -:   98:  mutable_buffer() BOOST_ASIO_NOEXCEPT
        -:   99:    : data_(0),
        -:  100:      size_(0)
        -:  101:  {
        -:  102:  }
