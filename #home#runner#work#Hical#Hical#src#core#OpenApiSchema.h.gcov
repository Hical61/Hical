        -:  250:// ============ 用户宏 ============
        -:  251:
        -:  252:/**
        -:  253: * @brief 为结构体注册 OpenAPI schema 名称（用于 $ref 引用）
        -:  254: * 用法：
        -:  255: *   struct UserDTO { ... HICAL_JSON(UserDTO, ...) };
        -:  256: *   HICAL_SCHEMA_NAME(UserDTO, "UserDTO")
        -:  257: * 注册后，嵌套引用此类型时将生成 {"$ref":"#/components/schemas/UserDTO"}
        -:  258: * 而非内联展开完整 schema
        -:  259: */
        -:  260:// NOLINTBEGIN(cppcoreguidelines-macro-usage)
        -:  261:#define HICAL_SCHEMA_NAME(Type, Name)              \
        -:  262:	template <>                                    \
        -:  263:	struct hical::meta::openapi::SchemaName<Type>  \
        -:  264:	{                                              \
        -:  265:		static constexpr const char* value = Name; \
        -:  266:	};
        -:  267:// NOLINTEND(cppcoreguidelines-macro-usage)
