        -:  223:		/**
        -:  224:		 * @brief 销毁指定 Session（登出场景）
        -:  225:		 * @param id Session ID
        -:  226:		 */
        -:  227:		void destroy(const std::string& id);
        -:  228:
        -:  229:		/**
        -:  230:		 * @brief 重新生成 Session ID（防 Session Fixation 攻击）
        -:  231:		 * 保留 Session 内的所有数据，仅更换 ID。旧 ID 立即失效。
        -:  232:		 * 典型场景：用户登录成功后调用此方法，确保攻击者无法利用预设的 Session ID。
        -:  233:		 * @param oldId 当前 Session ID
        -:  234:		 * @return 拥有相同数据但新 ID 的 Session，旧 ID 不存在时返回 nullptr
        -:  235:		 */
        -:  236:		std::shared_ptr<Session> regenerate(const std::string& oldId);
        -:  237:
        -:  238:		/**
        -:  239:		 * @brief 清理过期的 Session（应定期调用）
        -:  240:		 * @param force true 时跳过 gcInterval 双重检查，强制执行清理
        -:  241:		 */
        -:  242:		void gc(bool force = true);
        -:  243:
        -:  244:		/**
        -:  245:		 * @brief 获取当前活跃 Session 数量
        -:  246:		 * @return Session 数量
        -:  247:		 */
        -:  248:		size_t count();
        -:  249:
        -:  250:		/**
        -:  251:		 * @brief 获取配置选项
        -:  252:		 * @return SessionOptions 常量引用
        -:  253:		 */
    #####:  254:		const SessionOptions& options() const
        -:  255:		{
    #####:  256:			return opts_;
        -:  257:		}
        -:  258:
        -:  259:		/**
        -:  260:		 * @brief 请求上下文属性键（Session 存入 HttpRequest attribute 时使用的键名）
        -:  261:		 */
        -:  262:		static constexpr const char* hSessionKey = "hical.session";
        -:  263:
        -:  264:	private:
        -:  265:		/**
        -:  266:		 * @brief 生成随机 Session ID（64 位十六进制）
        -:  267:		 * @return Session ID 字符串
        -:  268:		 */
        -:  269:		static std::string generateId();
        -:  270:
        -:  271:		SessionOptions opts_;
        -:  272:		mutable std::shared_mutex mutex_;
        -:  273:		std::unordered_map<std::string, std::shared_ptr<Session>> store_;
        -:  274:		/// 上次懒 GC 触发时间（在写锁保护下访问）
        -:  275:		std::chrono::steady_clock::time_point lastGc_ = std::chrono::steady_clock::now();
        -:  276:	};
        -:  277:
        -:  278:	/**
        -:  279:	 * @brief 创建 Session 中间件
        -:  280:	 * Session 中间件做三件事：
        -:  281:	 * 1. 从请求 Cookie 中读取 Session ID，查找或创建 Session
        -:  282:	 * 2. 将 Session 对象注入 HttpRequest attribute（键：SessionManager::hSessionKey）
        -:  283:	 * 3. 请求处理完毕后，若 Session 被标记为 dirty，向响应写入 Set-Cookie
        -:  284:	 * 用法：
        -:  285:	 * ```cpp
        -:  286:	 * auto sessionMgr = std::make_shared<hical::SessionManager>();
        -:  287:	 * server.use(hical::makeSessionMiddleware(sessionMgr));
        -:  288:	 * // 在路由处理器中访问 Session
        -:  289:	 * server.router().get("/profile", [](const HttpRequest& req) -> HttpResponse {
        -:  290:	 *     auto session = req.getAttribute<std::shared_ptr<hical::Session>>(
        -:  291:	 *         hical::SessionManager::hSessionKey);
        -:  292:	 *     if (session && (*session)->has("user")) {
        -:  293:	 *         auto user = (*session)->get<std::string>("user");
        -:  294:	 *         return HttpResponse::ok("Hello " + *user);
        -:  295:	 *     }
        -:  296:	 *     return HttpResponse::badRequest("Not logged in");
        -:  297:	 * });
        -:  298:	 * ```
        -:  299:	 * @param manager Session 管理器（shared_ptr，可多个中间件共享同一个 manager）
        -:  300:	 * @return MiddlewareHandler 可传入 server.use() 的中间件
        -:  301:	 */
        -:  302:	inline MiddlewareHandler makeSessionMiddleware(std::shared_ptr<SessionManager> manager)
        -:  303:	{
        -:  304:		return [manager](HttpRequest& req, MiddlewareNext next) -> Awaitable<HttpResponse>
        -:  305:		{
        -:  306:			const auto& opts = manager->options();
        -:  307:
        -:  308:			// 1. 从 Cookie 中读取 Session ID
        -:  309:			auto sessionId = req.cookie(opts.cookieName);
        -:  310:			std::shared_ptr<Session> session;
        -:  311:
        -:  312:			if (!sessionId.empty())
        -:  313:			{
        -:  314:				session = manager->find(sessionId);
        -:  315:				// find() 内部会检查过期：过期 Session 被删除并返回 nullptr，
        -:  316:				// 随后走 create() 分配新 ID，下方 sessionId != session->id()
        -:  317:				// 会触发 Set-Cookie 将新 ID 写回客户端。
        -:  318:			}
        -:  319:			if (!session)
        -:  320:			{
        -:  321:				// 新建 Session（可能因达到上限返回 nullptr）
        -:  322:				session = manager->create();
        -:  323:				if (!session)
        -:  324:				{
        -:  325:					HttpResponse errRes;
        -:  326:					errRes.setStatus(HttpStatusCode::hServiceUnavailable);
        -:  327:					errRes.setBody("Service Unavailable: session store full");
        -:  328:					co_return errRes;
        -:  329:				}
        -:  330:			}
        -:  331:			session->touch();
        -:  332:
        -:  333:			// 2. 注入到请求 attribute
        -:  334:			req.setAttribute(SessionManager::hSessionKey, session);
        -:  335:
        -:  336:			// 3. 执行后续中间件/路由
        -:  337:			auto res = co_await next(req);
        -:  338:
        -:  339:			// 4. 如果 Session 被写过数据（dirty），刷新 Cookie
        -:  340:			if (session->isDirty() || sessionId != session->id())
        -:  341:			{
        -:  342:				CookieOptions cookieOpts;
        -:  343:				cookieOpts.maxAge = opts.maxAge;
        -:  344:				cookieOpts.httpOnly = opts.httpOnly;
        -:  345:				cookieOpts.secure = opts.secure;
        -:  346:				cookieOpts.sameSite = opts.sameSite;
        -:  347:				cookieOpts.path = opts.path;
        -:  348:				res.setCookie(opts.cookieName, session->id(), cookieOpts);
        -:  349:			}
        -:  350:
        -:  351:			co_return res;
        -:  352:		};
        -:  353:	}
        -:  354:
        -:  355:} // namespace hical
