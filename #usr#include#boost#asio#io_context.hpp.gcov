        -:  357:
        -:  358:  /// Run the io_context object's event processing loop until a specified time.
        -:  359:  /**
        -:  360:   * The run_until() function blocks until all work has finished and there are
        -:  361:   * no more handlers to be dispatched, until the io_context has been stopped,
        -:  362:   * or until the specified time has been reached.
        -:  363:   *
        -:  364:   * @param abs_time The time point until which the call may block.
        -:  365:   *
        -:  366:   * @return The number of handlers that were executed.
        -:  367:   */
        -:  368:  template <typename Clock, typename Duration>
        -:  369:  std::size_t run_until(const chrono::time_point<Clock, Duration>& abs_time);
        -:  370:#endif // defined(BOOST_ASIO_HAS_CHRONO) || defined(GENERATING_DOCUMENTATION)
        -:  371:
        -:  372:  /// Run the io_context object's event processing loop to execute at most one
        -:  373:  /// handler.
        -:  374:  /**
        -:  375:   * The run_one() function blocks until one handler has been dispatched, or
        -:  376:   * until the io_context has been stopped.
        -:  377:   *
        -:  378:   * @return The number of handlers that were executed. A zero return value
        -:  379:   * implies that the io_context object is stopped (the stopped() function
        -:  380:   * returns @c true). Subsequent calls to run(), run_one(), poll() or
        -:  381:   * poll_one() will return immediately unless there is a prior call to
        -:  382:   * restart().
        -:  383:   *
        -:  384:   * @note Calling the run_one() function from a thread that is currently
        -:  385:   * calling one of run(), run_one(), run_for(), run_until(), poll() or
        -:  386:   * poll_one() on the same io_context object may introduce the potential for
        -:  387:   * deadlock. It is the caller's reponsibility to avoid this.
        -:  388:   */
        -:  389:  BOOST_ASIO_DECL count_type run_one();
        -:  390:
        -:  391:#if !defined(BOOST_ASIO_NO_DEPRECATED)
        -:  392:  /// (Deprecated: Use non-error_code overload.) Run the io_context object's
        -:  393:  /// event processing loop to execute at most one handler.
        -:  394:  /**
        -:  395:   * The run_one() function blocks until one handler has been dispatched, or
        -:  396:   * until the io_context has been stopped.
        -:  397:   *
        -:  398:   * @return The number of handlers that were executed. A zero return value
        -:  399:   * implies that the io_context object is stopped (the stopped() function
        -:  400:   * returns @c true). Subsequent calls to run(), run_one(), poll() or
        -:  401:   * poll_one() will return immediately unless there is a prior call to
        -:  402:   * restart().
        -:  403:   *
        -:  404:   * @return The number of handlers that were executed.
        -:  405:   *
        -:  406:   * @note Calling the run_one() function from a thread that is currently
        -:  407:   * calling one of run(), run_one(), run_for(), run_until(), poll() or
        -:  408:   * poll_one() on the same io_context object may introduce the potential for
        -:  409:   * deadlock. It is the caller's reponsibility to avoid this.
        -:  410:   */
        -:  411:  BOOST_ASIO_DECL count_type run_one(boost::system::error_code& ec);
        -:  412:#endif // !defined(BOOST_ASIO_NO_DEPRECATED)
        -:  413:
        -:  414:#if defined(BOOST_ASIO_HAS_CHRONO) || defined(GENERATING_DOCUMENTATION)
        -:  415:  /// Run the io_context object's event processing loop for a specified duration
        -:  416:  /// to execute at most one handler.
        -:  417:  /**
        -:  418:   * The run_one_for() function blocks until one handler has been dispatched,
        -:  419:   * until the io_context has been stopped, or until the specified duration has
