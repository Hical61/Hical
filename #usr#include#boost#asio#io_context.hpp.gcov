        -: 1130:/// (Deprecated: Use executor_work_guard.) Class to inform the io_context when
        -: 1131:/// it has work to do.
        -: 1132:/**
        -: 1133: * The work class is used to inform the io_context when work starts and
        -: 1134: * finishes. This ensures that the io_context object's run() function will not
        -: 1135: * exit while work is underway, and that it does exit when there is no
        -: 1136: * unfinished work remaining.
        -: 1137: *
        -: 1138: * The work class is copy-constructible so that it may be used as a data member
        -: 1139: * in a handler class. It is not assignable.
        -: 1140: */
        -: 1141:class io_context::work
        -: 1142:{
        -: 1143:public:
        -: 1144:  /// Constructor notifies the io_context that work is starting.
        -: 1145:  /**
        -: 1146:   * The constructor is used to inform the io_context that some work has begun.
        -: 1147:   * This ensures that the io_context object's run() function will not exit
        -: 1148:   * while the work is underway.
        -: 1149:   */
        -: 1150:  explicit work(boost::asio::io_context& io_context);
        -: 1151:
        -: 1152:  /// Copy constructor notifies the io_context that work is starting.
        -: 1153:  /**
        -: 1154:   * The constructor is used to inform the io_context that some work has begun.
        -: 1155:   * This ensures that the io_context object's run() function will not exit
        -: 1156:   * while the work is underway.
        -: 1157:   */
        -: 1158:  work(const work& other);
        -: 1159:
        -: 1160:  /// Destructor notifies the io_context that the work is complete.
        -: 1161:  /**
        -: 1162:   * The destructor is used to inform the io_context that some work has
        -: 1163:   * finished. Once the count of unfinished work reaches zero, the io_context
        -: 1164:   * object's run() function is permitted to exit.
        -: 1165:   */
        -: 1166:  ~work();
        -: 1167:
        -: 1168:  /// Get the io_context associated with the work.
        -: 1169:  boost::asio::io_context& get_io_context();
        -: 1170:
        -: 1171:private:
        -: 1172:  // Prevent assignment.
