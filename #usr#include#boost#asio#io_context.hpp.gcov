        -:  210:  template <typename Allocator, uintptr_t Bits>
        -:  211:  class basic_executor_type;
        -:  212:
        -:  213:  template <typename Allocator, uintptr_t Bits>
        -:  214:  friend class basic_executor_type;
        -:  215:
        -:  216:  /// Executor used to submit functions to an io_context.
        -:  217:  typedef basic_executor_type<std::allocator<void>, 0> executor_type;
        -:  218:
        -:  219:#if !defined(BOOST_ASIO_NO_DEPRECATED)
        -:  220:  class work;
        -:  221:  friend class work;
        -:  222:#endif // !defined(BOOST_ASIO_NO_DEPRECATED)
        -:  223:
        -:  224:  class service;
        -:  225:
        -:  226:#if !defined(BOOST_ASIO_NO_EXTENSIONS) \
        -:  227:  && !defined(BOOST_ASIO_NO_TS_EXECUTORS)
        -:  228:  class strand;
        -:  229:#endif // !defined(BOOST_ASIO_NO_EXTENSIONS)
        -:  230:       //   && !defined(BOOST_ASIO_NO_TS_EXECUTORS)
        -:  231:
        -:  232:  /// The type used to count the number of handlers executed by the context.
        -:  233:  typedef std::size_t count_type;
        -:  234:
        -:  235:  /// Constructor.
        -:  236:  BOOST_ASIO_DECL io_context();
        -:  237:
        -:  238:  /// Constructor.
        -:  239:  /**
        -:  240:   * Construct with a hint about the required level of concurrency.
        -:  241:   *
        -:  242:   * @param concurrency_hint A suggestion to the implementation on how many
        -:  243:   * threads it should allow to run simultaneously.
        -:  244:   */
        -:  245:  BOOST_ASIO_DECL explicit io_context(int concurrency_hint);
        -:  246:
        -:  247:  /// Destructor.
        -:  248:  /**
        -:  249:   * On destruction, the io_context performs the following sequence of
        -:  250:   * operations:
        -:  251:   *
        -:  252:   * @li For each service object @c svc in the io_context set, in reverse order
        -:  253:   * of the beginning of service object lifetime, performs
        -:  254:   * @c svc->shutdown().
        -:  255:   *
        -:  256:   * @li Uninvoked handler objects that were scheduled for deferred invocation
        -:  257:   * on the io_context, or any associated strand, are destroyed.
        -:  258:   *
        -:  259:   * @li For each service object @c svc in the io_context set, in reverse order
        -:  260:   * of the beginning of service object lifetime, performs
        -:  261:   * <tt>delete static_cast<io_context::service*>(svc)</tt>.
        -:  262:   *
        -:  263:   * @note The destruction sequence described above permits programs to
        -:  264:   * simplify their resource management by using @c shared_ptr<>. Where an
        -:  265:   * object's lifetime is tied to the lifetime of a connection (or some other
        -:  266:   * sequence of asynchronous operations), a @c shared_ptr to the object would
        -:  267:   * be bound into the handlers for all asynchronous operations associated with
        -:  268:   * it. This works as follows:
        -:  269:   *
        -:  270:   * @li When a single connection ends, all associated asynchronous operations
        -:  271:   * complete. The corresponding handler objects are destroyed, and all
        -:  272:   * @c shared_ptr references to the objects are destroyed.
        -:  273:   *
        -:  274:   * @li To shut down the whole program, the io_context function stop() is
        -:  275:   * called to terminate any run() calls as soon as possible. The io_context
        -:  276:   * destructor defined above destroys all handlers, causing all @c shared_ptr
        -:  277:   * references to all connection objects to be destroyed.
        -:  278:   */
        -:  279:  BOOST_ASIO_DECL ~io_context();
        -:  280:
        -:  281:  /// Obtains the executor associated with the io_context.
        -:  282:  executor_type get_executor() BOOST_ASIO_NOEXCEPT;
        -:  283:
        -:  284:  /// Run the io_context object's event processing loop.
        -:  285:  /**
        -:  286:   * The run() function blocks until all work has finished and there are no
        -:  287:   * more handlers to be dispatched, or until the io_context has been stopped.
        -:  288:   *
        -:  289:   * Multiple threads may call the run() function to set up a pool of threads
        -:  290:   * from which the io_context may execute handlers. All threads that are
        -:  291:   * waiting in the pool are equivalent and the io_context may choose any one
        -:  292:   * of them to invoke a handler.
        -:  293:   *
        -:  294:   * A normal exit from the run() function implies that the io_context object
        -:  295:   * is stopped (the stopped() function returns @c true). Subsequent calls to
        -:  296:   * run(), run_one(), poll() or poll_one() will return immediately unless there
        -:  297:   * is a prior call to restart().
        -:  298:   *
        -:  299:   * @return The number of handlers that were executed.
        -:  300:   *
        -:  301:   * @note Calling the run() function from a thread that is currently calling
        -:  302:   * one of run(), run_one(), run_for(), run_until(), poll() or poll_one() on
        -:  303:   * the same io_context object may introduce the potential for deadlock. It is
        -:  304:   * the caller's reponsibility to avoid this.
        -:  305:   *
        -:  306:   * The poll() function may also be used to dispatch ready handlers, but
        -:  307:   * without blocking.
        -:  308:   */
        -:  309:  BOOST_ASIO_DECL count_type run();
        -:  310:
        -:  311:#if !defined(BOOST_ASIO_NO_DEPRECATED)
        -:  312:  /// (Deprecated: Use non-error_code overload.) Run the io_context object's
        -:  313:  /// event processing loop.
        -:  314:  /**
        -:  315:   * The run() function blocks until all work has finished and there are no
        -:  316:   * more handlers to be dispatched, or until the io_context has been stopped.
        -:  317:   *
        -:  318:   * Multiple threads may call the run() function to set up a pool of threads
        -:  319:   * from which the io_context may execute handlers. All threads that are
        -:  320:   * waiting in the pool are equivalent and the io_context may choose any one
        -:  321:   * of them to invoke a handler.
        -:  322:   *
        -:  323:   * A normal exit from the run() function implies that the io_context object
        -:  324:   * is stopped (the stopped() function returns @c true). Subsequent calls to
        -:  325:   * run(), run_one(), poll() or poll_one() will return immediately unless there
        -:  326:   * is a prior call to restart().
        -:  327:   *
        -:  328:   * @param ec Set to indicate what error occurred, if any.
        -:  329:   *
        -:  330:   * @return The number of handlers that were executed.
        -:  331:   *
        -:  332:   * @note Calling the run() function from a thread that is currently calling
        -:  333:   * one of run(), run_one(), run_for(), run_until(), poll() or poll_one() on
        -:  334:   * the same io_context object may introduce the potential for deadlock. It is
        -:  335:   * the caller's reponsibility to avoid this.
        -:  336:   *
        -:  337:   * The poll() function may also be used to dispatch ready handlers, but
        -:  338:   * without blocking.
        -:  339:   */
        -:  340:  BOOST_ASIO_DECL count_type run(boost::system::error_code& ec);
        -:  341:#endif // !defined(BOOST_ASIO_NO_DEPRECATED)
        -:  342:
        -:  343:#if defined(BOOST_ASIO_HAS_CHRONO) || defined(GENERATING_DOCUMENTATION)
        -:  344:  /// Run the io_context object's event processing loop for a specified
        -:  345:  /// duration.
        -:  346:  /**
        -:  347:   * The run_for() function blocks until all work has finished and there are no
        -:  348:   * more handlers to be dispatched, until the io_context has been stopped, or
        -:  349:   * until the specified duration has elapsed.
        -:  350:   *
        -:  351:   * @param rel_time The duration for which the call may block.
        -:  352:   *
        -:  353:   * @return The number of handlers that were executed.
        -:  354:   */
        -:  355:  template <typename Rep, typename Period>
