/**
 * @file app.cpp
 * @brief 示例 HTTP 路由
 */

#include "app.h"

#include <hical/core/Router.h>
#include <hical/core/HttpRequest.h>
#include <hical/core/HttpResponse.h>

namespace app
{
	void registerRoutes(hical::Router& router)
	{
		router.get("/",
				   [](const hical::HttpRequest&) -> hical::HttpResponse
				   {
					   return hical::HttpResponse::ok("Hical 已启动\n");
				   });
	}
} // namespace app
