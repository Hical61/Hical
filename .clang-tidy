# 文档：https://clang.llvm.org/extra/clang-tidy/checks/list.html

ExtraArgs: [-std=c++2a]
Checks: '-*,
      #-clang-diagnostic-pragma-once-outside-header,
      readability-*,
      -readability-identifier-length,
      -readability-magic-numbers,
      -readability-redundant-access-specifiers,
      bugprone-*,
      -bugprone-easily-swappable-parameters,
      cppcoreguidelines-*,
	  -cppcoreguidelines-avoid-non-const-global-variables
      -cppcoreguidelines-pro-type-reinterpret-cast,
      -cppcoreguidelines-avoid-c-arrays,
      -cppcoreguidelines-avoid-magic-numbers,
      -cppcoreguidelines-owning-memory,
      -cppcoreguidelines-virtual-class-destructor,
      -cppcoreguidelines-special-member-functions,
      -cppcoreguidelines-non-private-member-variables-in-classes,
      modernize-*,
      -modernize-use-auto,
      -modernize-avoid-c-arrays,
      -modernize-use-default-member-init,
      -modernize-use-trailing-return-type,
      misc-*,
      -misc-unused-parameters,
      -misc-non-private-member-variables-in-classes,
      -misc-const-correctness,
      performance-*'

CheckOptions:
  # 结构体使用大驼峰，无前缀
  # struct HttpServer {};
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase

  # 枚举使用大驼峰，无前缀；枚举常量保留 E 前缀
  # enum HttpMethod { EGet, EPost };
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantPrefix
    value:           E

  # 抽象接口类使用大驼峰，无前缀
  # class EventLoop { virtual ... };
  - key:             readability-identifier-naming.AbstractClassCase
    value:           CamelCase

  # 类名使用大驼峰，无前缀
  # class HttpServer {};
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase

  # 类静态常量：小驼峰 + m_ 前缀
  # class Foo { public: static const int m_classConstant; };
  - key:             readability-identifier-naming.ClassConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.ClassConstantPrefix
    value:           m_

  # const 成员变量：小驼峰 + m_ 前缀
  # class Foo { const char m_constMember; };
  - key:             readability-identifier-naming.ConstantMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.ConstantMemberPrefix
    value:           m_

  # 类成员（static）：小驼峰 + m_ 前缀
  # class Foo { public: static int m_classMember; };
  - key:             readability-identifier-naming.ClassMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.ClassMemberPrefix
    value:           m_

  # private 成员变量：小驼峰 + m_ 前缀
  # class Foo { private: int m_value; };
  - key:             readability-identifier-naming.PrivateMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.PrivateMemberPrefix
    value:           m_

  # protected 成员变量：小驼峰 + m_ 前缀
  # class Foo { protected: int m_value; };
  - key:             readability-identifier-naming.ProtectedMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.ProtectedMemberPrefix
    value:           m_

  # 局部常量：小驼峰 + c 前缀
  # void func() { int const cMyConst = 0; }
  - key:             readability-identifier-naming.ConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.ConstantPrefix
    value:           c

  - key:             readability-identifier-naming.LocalConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.LocalConstantPrefix
    value:           c

  # 全局常量：小驼峰 + g_c 前缀
  # unsigned const g_cMyConstGlobal[] = {1, 2, 3};
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.GlobalConstantPrefix
    value:           g_c

  # 函数使用小驼峰命名
  - key:             readability-identifier-naming.GlobalFunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.FunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.MethodCase
    value:           camelBack

  # 变量统一使用小驼峰
  - key:             readability-identifier-naming.VariableCase
    value:           camelBack

  # 全局变量：小驼峰 + g_ 前缀
  # int g_globalVar;
  - key:             readability-identifier-naming.GlobalVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.GlobalVariablePrefix
    value:           g_

  # 局部变量：小驼峰
  # void foo() { int localVar = 3; }
  - key:             readability-identifier-naming.LocalVariableCase
    value:           camelBack

  # 宏定义使用全大写
  # #define MY_MACRO_DEFINITION
  - key:             readability-identifier-naming.MacroDefinitionCase
    value:           UPPER_CASE

  # 参数：小驼峰
  # void func(int param);
  - key:             readability-identifier-naming.ParameterCase
    value:           camelBack

  # const 参数：小驼峰
  # void func(const int param);
  - key:             readability-identifier-naming.ConstantParameterCase
    value:           camelBack


  # 静态变量：小驼峰 + s 前缀
  # static unsigned sMyStaticVar;
  - key:             readability-identifier-naming.StaticVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.StaticVariablePrefix
    value:           s

  # 静态常量：小驼峰 + c 前缀
  # static unsigned const cMyStaticConst = 0;
  - key:             readability-identifier-naming.StaticConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.StaticConstantPrefix
    value:           c

  # 指针参数：大驼峰 + p 前缀
  # void func(int* pParam);
  - key:             readability-identifier-naming.PointerParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.PointerParameterIgnoredRegexp
    value:           "psz.*|pscw.*"
  - key:             readability-identifier-naming.PointerParameterPrefix
    value:           p

  # const 指针参数：大驼峰 + p 前缀
  # void func(const int* pParam);
  - key:             readability-identifier-naming.ConstantPointerParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.ConstantPointerParameterIgnoredRegexp
    value:           "psz.*"
  - key:             readability-identifier-naming.ConstantPointerParameterPrefix
    value:           p

  # 全局指针：大驼峰 + g_p 前缀
  # int* g_pGlobal;
  - key:             readability-identifier-naming.GlobalPointerCase
    value:           CamelCase
  - key:             readability-identifier-naming.GlobalPointerIgnoredRegexp
    value:           "psz.*"
  - key:             readability-identifier-naming.GlobalPointerPrefix
    value:           g_p

  # 局部指针：大驼峰 + p 前缀
  # void foo() { int* pLocal; }
  - key:             readability-identifier-naming.LocalPointerCase
    value:           CamelCase
  - key:             readability-identifier-naming.LocalPointerIgnoredRegexp
    value:           "psz.*"
  - key:             readability-identifier-naming.LocalPointerPrefix
    value:           p

  # 局部 const 指针：大驼峰 + p 前缀
  # void foo() { const int* pLocalConst; }
  - key:             readability-identifier-naming.LocalConstantPointerCase
    value:           CamelCase
  - key:             readability-identifier-naming.LocalConstantPointerIgnoredRegexp
    value:           "psz.*"
  - key:             readability-identifier-naming.LocalConstantPointerPrefix
    value:           p

  # 全局 const 指针：大驼峰 + g_p 前缀
  - key:             readability-identifier-naming.GlobalConstantPointerCase
    value:           CamelCase
  - key:             readability-identifier-naming.GlobalConstantPointerIgnoredRegexp
    value:           "psz.*"
  - key:             readability-identifier-naming.GlobalConstantPointerPrefix
    value:           g_p

  # 模板参数名称使用大驼峰
  - key:             readability-identifier-naming.TemplateParameterCase
    value:           CamelCase

  # 使用typedef和using重命名类型时，使用大驼峰
  - key:             readability-identifier-naming.TypedefCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeAliasCase
    value:           CamelCase

  # 超过 150 行的函数警告
  - key:             readability-function-size.LineThreshold
    value:           150
  # 函数参数超过5个的警报
  - key:             readability-function-size.ParameterThreshold
    value:           5
  # 函数嵌套超过4个的警报
  - key:             readability-function-size.NestingThreshold
    value:           4
  # 全部都是 public 成员的时候不警告成员私有化
  - key:             misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value:           true
  - key:             cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value:           true
