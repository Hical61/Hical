        -:  550:    /** Return the associated @ref memory_resource
        -:  551:
        -:  552:        This returns the @ref memory_resource used by
        -:  553:        the container.
        -:  554:
        -:  555:        @par Complexity
        -:  556:        Constant.
        -:  557:
        -:  558:        @par Exception Safety
        -:  559:        No-throw guarantee.
        -:  560:    */
        -:  561:    storage_ptr const&
        -:  562:    storage() const noexcept
        -:  563:    {
        -:  564:        return sp_;
        -:  565:    }
        -:  566:
        -:  567:    /** Return the associated @ref memory_resource
        -:  568:
        -:  569:        This function returns an instance of
        -:  570:        @ref polymorphic_allocator constructed from the
        -:  571:        associated @ref memory_resource.
