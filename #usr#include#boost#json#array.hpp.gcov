        -:  978:    //------------------------------------------------------
        -:  979:    //
        -:  980:    // Capacity
        -:  981:    //
        -:  982:    //------------------------------------------------------
        -:  983:
        -:  984:    /** Return the number of elements in the array.
        -:  985:
        -:  986:        This returns the number of elements in the array.
        -:  987:        The value returned may be different from the number
        -:  988:        returned from @ref capacity.
        -:  989:
        -:  990:        @par Complexity
        -:  991:        Constant.
        -:  992:
        -:  993:        @par Exception Safety
        -:  994:        No-throw guarantee.
        -:  995:    */
        -:  996:    inline
        -:  997:    std::size_t
        -:  998:    size() const noexcept;
        -:  999:
        -: 1000:    /** Return the maximum number of elements any array can hold.
        -: 1001:
        -: 1002:        The maximum is an implementation-defined number.
        -: 1003:        This value is a theoretical limit; at runtime,
        -: 1004:        the actual maximum size may be less due to
        -: 1005:        resource limits.
        -: 1006:
        -: 1007:        @par Complexity
        -: 1008:        Constant.
        -: 1009:
        -: 1010:        @par Exception Safety
        -: 1011:        No-throw guarantee.
        -: 1012:    */
        -: 1013:    static
        -: 1014:    inline
        -: 1015:    constexpr
        -: 1016:    std::size_t
        -: 1017:    max_size() noexcept;
        -: 1018:
        -: 1019:    /** Return the number of elements that can be held in currently allocated memory.
        -: 1020:
        -: 1021:        This number may be larger than the value returned
        -: 1022:        by @ref size().
        -: 1023:
        -: 1024:        @par Complexity
        -: 1025:        Constant.
        -: 1026:
        -: 1027:        @par Exception Safety
        -: 1028:        No-throw guarantee.
        -: 1029:    */
        -: 1030:    inline
        -: 1031:    std::size_t
        -: 1032:    capacity() const noexcept;
        -: 1033:
        -: 1034:    /** Check if the array has no elements.
        -: 1035:
        -: 1036:        Returns `true` if there are no elements in the
        -: 1037:        array, i.e. @ref size() returns 0.
        -: 1038:
        -: 1039:        @par Complexity
        -: 1040:        Constant.
        -: 1041:
        -: 1042:        @par Exception Safety
        -: 1043:        No-throw guarantee.
        -: 1044:    */
        -: 1045:    inline
        -: 1046:    bool
        -: 1047:    empty() const noexcept;
        -: 1048:
        -: 1049:    /** Increase the capacity to at least a certain amount.
        -: 1050:
        -: 1051:        This increases the @ref capacity() to a value
        -: 1052:        that is greater than or equal to `new_capacity`.
        -: 1053:        If `new_capacity > capacity()`, new memory is
        -: 1054:        allocated. Otherwise, the call has no effect.
        -: 1055:        The number of elements and therefore the
        -: 1056:        @ref size() of the container is not changed.
        -: 1057:    \n
        -: 1058:        If new memory is allocated, all iterators
        -: 1059:        including any past-the-end iterators, and all
        -: 1060:        references to the elements are invalidated.
        -: 1061:        Otherwise, no iterators or references are
        -: 1062:        invalidated.
        -: 1063:
        -: 1064:        @par Complexity
        -: 1065:        At most, linear in @ref size().
        -: 1066:
        -: 1067:        @par Exception Safety
        -: 1068:        Strong guarantee.
        -: 1069:        Calls to `memory_resource::allocate` may throw.
        -: 1070:
        -: 1071:        @param new_capacity The new capacity of the array.
        -: 1072:
        -: 1073:        @throw system_error `new_capacity > max_size()`
        -: 1074:    */
        -: 1075:    inline
        -: 1076:    void
        -: 1077:    reserve(std::size_t new_capacity);
        -: 1078:
        -: 1079:    /** Request the removal of unused capacity.
        -: 1080:
        -: 1081:        This performs a non-binding request to reduce the
        -: 1082:        capacity to the current size. The request may or
        -: 1083:        may not be fulfilled. If reallocation occurs, all
        -: 1084:        iterators including any past-the-end iterators,
        -: 1085:        and all references to the elements are invalidated.
        -: 1086:        Otherwise, no iterators or references are
        -: 1087:        invalidated.
        -: 1088:
        -: 1089:        @par Complexity
        -: 1090:        At most, linear in @ref size().
        -: 1091:
        -: 1092:        @par Exception Safety
        -: 1093:        No-throw guarantee.
        -: 1094:    */
        -: 1095:    BOOST_JSON_DECL
        -: 1096:    void
        -: 1097:    shrink_to_fit() noexcept;
        -: 1098:
        -: 1099:    //------------------------------------------------------
        -: 1100:    //
        -: 1101:    // Modifiers
        -: 1102:    //
        -: 1103:    //------------------------------------------------------
        -: 1104:
        -: 1105:    /** Clear the contents.
        -: 1106:
        -: 1107:        Erases all elements from the container. After this
        -: 1108:        call, @ref size() returns zero but @ref capacity()
        -: 1109:        is unchanged. All references, pointers, or iterators
        -: 1110:        referring to contained elements are invalidated. Any
        -: 1111:        past-the-end iterators are also invalidated.
        -: 1112:
        -: 1113:        @par Complexity
        -: 1114:        Linear in @ref size().
        -: 1115:
        -: 1116:        @par Exception Safety
        -: 1117:        No-throw guarantee.
        -: 1118:    */
        -: 1119:    BOOST_JSON_DECL
        -: 1120:    void
        -: 1121:    clear() noexcept;
        -: 1122:
        -: 1123:    /** Insert elements before the specified location.
        -: 1124:
        -: 1125:        This inserts a copy of `v` before `pos`.
        -: 1126:        If `capacity() < size() + 1`, a reallocation
        -: 1127:        occurs first, and all iterators and references
        -: 1128:        are invalidated.
        -: 1129:        Otherwise, only the iterators and references from
        -: 1130:        the insertion point forward are invalidated. All
        -: 1131:        past-the-end iterators are also invalidated.
        -: 1132:
        -: 1133:        @par Complexity
        -: 1134:        Constant plus linear in `std::distance(pos, end())`.
        -: 1135:
        -: 1136:        @par Exception Safety
        -: 1137:        Strong guarantee.
        -: 1138:        Calls to `memory_resource::allocate` may throw.
        -: 1139:
        -: 1140:        @param pos Iterator before which the content will
        -: 1141:        be inserted. This may be the @ref end() iterator.
        -: 1142:
        -: 1143:        @param v The value to insert. A copy will be made
        -: 1144:        using container's associated @ref memory_resource.
        -: 1145:
        -: 1146:        @return An iterator to the inserted value
        -: 1147:    */
        -: 1148:    BOOST_JSON_DECL
        -: 1149:    iterator
        -: 1150:    insert(
        -: 1151:        const_iterator pos,
        -: 1152:        value const& v);
        -: 1153:
        -: 1154:    /** Insert elements before the specified location.
        -: 1155:
        -: 1156:        This inserts `v` before `pos` via move-construction.
        -: 1157:        If `capacity() < size() + 1`, a reallocation occurs
        -: 1158:        first, and all iterators and references are
        -: 1159:        invalidated.
        -: 1160:        Otherwise, only the iterators and references from
        -: 1161:        the insertion point forward are invalidated. All
        -: 1162:        past-the-end iterators are also invalidated.
