        -:  573:        @par Complexity
        -:  574:        Constant.
        -:  575:
        -:  576:        @par Exception Safety
        -:  577:        No-throw guarantee.
        -:  578:    */
        -:  579:    allocator_type
        -:  580:    get_allocator() const noexcept
        -:  581:    {
        -:  582:        return sp_.get();
        -:  583:    }
        -:  584:
        -:  585:    //------------------------------------------------------
        -:  586:    //
        -:  587:    // Element access
        -:  588:    //
        -:  589:    //------------------------------------------------------
        -:  590:
        -:  591:    /** Access an element, with bounds checking.
        -:  592:
        -:  593:        Returns a reference to the element specified at
        -:  594:        location `pos`, with bounds checking. If `pos` is
        -:  595:        not within the range of the container, an exception
        -:  596:        of type @ref system_error is thrown.
        -:  597:
        -:  598:        @par Complexity
        -:  599:        Constant.
        -:  600:
        -:  601:        @param pos A zero-based index.
        -:  602:
        -:  603:        @throw system_error `pos >= size()`
        -:  604:    */
        -:  605:    /* @{ */
        -:  606:    inline
        -:  607:    value&
        -:  608:    at(std::size_t pos) &;
        -:  609:
        -:  610:    inline
        -:  611:    value&&
        -:  612:    at(std::size_t pos) &&;
        -:  613:
        -:  614:    inline
        -:  615:    value const&
        -:  616:    at(std::size_t pos) const&;
        -:  617:    /* @} */
        -:  618:
        -:  619:    /** Access an element.
        -:  620:
        -:  621:        Returns a reference to the element specified at
        -:  622:        location `pos`. No bounds checking is performed.
        -:  623:
        -:  624:        @par Precondition
        -:  625:        `pos < size()`
        -:  626:
        -:  627:        @par Complexity
        -:  628:        Constant.
        -:  629:
        -:  630:        @param pos A zero-based index
        -:  631:    */
        -:  632:    /* @{ */
        -:  633:    inline
        -:  634:    value&
        -:  635:    operator[](std::size_t pos) & noexcept;
        -:  636:
        -:  637:    inline
        -:  638:    value&&
        -:  639:    operator[](std::size_t pos) && noexcept;
        -:  640:
        -:  641:    inline
        -:  642:    value const&
        -:  643:    operator[](std::size_t pos) const& noexcept;
        -:  644:    /* @} */
        -:  645:
        -:  646:    /** Access the first element.
        -:  647:
        -:  648:        Returns a reference to the first element.
        -:  649:
        -:  650:        @par Precondition
        -:  651:        `not empty()`
        -:  652:
        -:  653:        @par Complexity
        -:  654:        Constant.
        -:  655:    */
        -:  656:    /* @{ */
        -:  657:    inline
        -:  658:    value&
        -:  659:    front() & noexcept;
        -:  660:
        -:  661:    inline
        -:  662:    value&&
        -:  663:    front() && noexcept;
        -:  664:
        -:  665:    inline
        -:  666:    value const&
        -:  667:    front() const& noexcept;
        -:  668:    /* @} */
        -:  669:
        -:  670:    /** Access the last element.
        -:  671:
        -:  672:        Returns a reference to the last element.
        -:  673:
        -:  674:        @par Precondition
        -:  675:        `not empty()`
        -:  676:
        -:  677:        @par Complexity
        -:  678:        Constant.
        -:  679:    */
        -:  680:    /* @{ */
        -:  681:    inline
        -:  682:    value&
        -:  683:    back() & noexcept;
        -:  684:
        -:  685:    inline
        -:  686:    value&&
        -:  687:    back() && noexcept;
        -:  688:
        -:  689:    inline
        -:  690:    value const&
        -:  691:    back() const& noexcept;
        -:  692:    /* @} */
        -:  693:
        -:  694:    /** Access the underlying array directly.
        -:  695:
        -:  696:        Returns a pointer to the underlying array serving
        -:  697:        as element storage. The value returned is such that
        -:  698:        the range `{data(), data() + size())` is always a
        -:  699:        valid range, even if the container is empty.
        -:  700:
        -:  701:        @par Complexity
        -:  702:        Constant.
        -:  703:
        -:  704:        @par Exception Safety
        -:  705:        No-throw guarantee.
        -:  706:
        -:  707:        @note
        -:  708:
        -:  709:        If `size() == 0`, the function may or may not return
        -:  710:        a null pointer.
        -:  711:    */
        -:  712:    inline
        -:  713:    value*
        -:  714:    data() noexcept;
        -:  715:
        -:  716:    /** Access the underlying array directly.
        -:  717:
        -:  718:        Returns a pointer to the underlying array serving
        -:  719:        as element storage. The value returned is such that
        -:  720:        the range `{data(), data() + size())` is always a
        -:  721:        valid range, even if the container is empty.
        -:  722:
        -:  723:        @par Complexity
        -:  724:        Constant.
        -:  725:
        -:  726:        @par Exception Safety
        -:  727:        No-throw guarantee.
        -:  728:
        -:  729:        @note
        -:  730:
        -:  731:        If `size() == 0`, the function may or may not return
        -:  732:        a null pointer.
        -:  733:    */
        -:  734:    inline
        -:  735:    value const*
        -:  736:    data() const noexcept;
        -:  737:
        -:  738:    /** Return a pointer to an element, or nullptr if the index is invalid
        -:  739:
        -:  740:        This function returns a pointer to the element
        -:  741:        at index `pos` when the index is less then the size
        -:  742:        of the container. Otherwise it returns null.
        -:  743:
        -:  744:        @par Example
        -:  745:        @code
        -:  746:        if( auto p = arr.if_contains( 1 ) )
        -:  747:            std::cout << *p;
        -:  748:        @endcode
        -:  749:
        -:  750:        @par Complexity
        -:  751:        Constant.
        -:  752:
        -:  753:        @par Exception Safety
        -:  754:        No-throw guarantee.
        -:  755:
        -:  756:        @param pos The index of the element to return.
        -:  757:    */
        -:  758:    inline
        -:  759:    value const*
        -:  760:    if_contains(std::size_t pos) const noexcept;
        -:  761:
        -:  762:    /** Return a pointer to an element, or nullptr if the index is invalid
        -:  763:
        -:  764:        This function returns a pointer to the element
        -:  765:        at index `pos` when the index is less then the size
        -:  766:        of the container. Otherwise it returns null.
        -:  767:
        -:  768:        @par Example
        -:  769:        @code
        -:  770:        if( auto p = arr.if_contains( 1 ) )
        -:  771:            std::cout << *p;
        -:  772:        @endcode
