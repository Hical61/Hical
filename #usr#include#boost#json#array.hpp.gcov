        -:  923:    inline
        -:  924:    const_reverse_iterator
        -:  925:    crbegin() const noexcept;
        -:  926:
        -:  927:    /** Return a reverse iterator to the element following the last element of the reversed container.
        -:  928:
        -:  929:        The pointed-to element corresponds to the element
        -:  930:        preceding the first element of the non-reversed container.
        -:  931:        The element acts as a placeholder; attempting
