{
  "name": "hical61-hical",
  "version": "2.7.2",
  "description": "Modern C++20/C++26 high-performance web framework based on Boost.Asio with native HTTP/WebSocket stack",
  "homepage": "https://github.com/Hical61/Hical",
  "license": "MIT",
  "supports": "!uwp & !xbox & !android & !emscripten",
  "dependencies": [
    "boost-asio",
    "boost-json",
    "boost-system",
    {
      "name": "liburing",
      "platform": "linux"
    },
    "openssl",
    "picohttpparser",
    "zlib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "http-client": {
      "description": "Coroutine HTTP client (requires Boost.Asio >= 1.86)",
      "dependencies": [
        "boost-asio"
      ]
    },
    "http2": {
      "description": "TLS HTTP/2 support (requires nghttp2 >= 1.70 and < 2)",
      "dependencies": [
        "nghttp2"
      ]
    },
    "database": {
      "description": "Database middleware with MySQL support (requires Boost.MySQL)",
      "dependencies": [
        "boost-mysql",
        "boost-charconv"
      ]
    }
  }
}
