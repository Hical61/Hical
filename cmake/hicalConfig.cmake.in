@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost 1.78 COMPONENTS json)
if(NOT TARGET Boost::system)
    add_library(Boost::system ALIAS Boost::headers)
endif()
find_dependency(OpenSSL)

include("${CMAKE_CURRENT_LIST_DIR}/hicalTargets.cmake")

check_required_components(hical)
