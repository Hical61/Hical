@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost 1.82 COMPONENTS json)
if(NOT TARGET Boost::system)
    add_library(Boost::system ALIAS Boost::headers)
endif()
if(@HICAL_WITH_HTTP2@)
    find_dependency(OpenSSL 1.1.1)
else()
    find_dependency(OpenSSL)
endif()
find_dependency(ZLIB)

if(@HICAL_WITH_HTTP_CLIENT@)
    find_dependency(Boost 1.86 COMPONENTS json)
endif()

if(@HICAL_WITH_HTTP2@)
    set(_hical_saved_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Nghttp2 1.70...<2)
    set(CMAKE_MODULE_PATH "${_hical_saved_module_path}")
    unset(_hical_saved_module_path)
endif()

# DB 中间件依赖（构建时由 CMake 写入实际值）
set(_HICAL_WITH_DATABASE @HICAL_WITH_DATABASE@)
if(_HICAL_WITH_DATABASE)
    find_dependency(Boost 1.85 COMPONENTS charconv)
endif()
unset(_HICAL_WITH_DATABASE)

include("${CMAKE_CURRENT_LIST_DIR}/hicalTargets.cmake")

check_required_components(hical)
