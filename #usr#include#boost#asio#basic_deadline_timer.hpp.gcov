        -:  140:  template <typename Executor1>
        -:  141:  struct rebind_executor
        -:  142:  {
        -:  143:    /// The timer type when rebound to the specified executor.
        -:  144:    typedef basic_deadline_timer<Time, TimeTraits, Executor1> other;
        -:  145:  };
