        -:   91:/// Submits a completion token or function object for execution.
        -:   92:/**
        -:   93: * This function submits an object for execution using the specified executor.
        -:   94: * The function object is queued for execution, and is never called from the
        -:   95: * current thread prior to returning from <tt>post()</tt>.
        -:   96: *
        -:   97: * The use of @c post(), rather than @ref defer(), indicates the caller's
        -:   98: * preference that the function object be eagerly queued for execution.
        -:   99: *
        -:  100: * @param ex The target executor.
        -:  101: *
        -:  102: * @param token The @ref completion_token that will be used to produce a
        -:  103: * completion handler. The function signature of the completion handler must be:
        -:  104: * @code void handler(); @endcode
        -:  105: *
        -:  106: * @returns This function returns <tt>async_initiate<NullaryToken,
        -:  107: * void()>(Init{ex}, token)</tt>, where @c Init is a function object type
        -:  108: * defined as:
        -:  109: *
        -:  110: * @code class Init
        -:  111: * {
        -:  112: * public:
        -:  113: *   using executor_type = Executor;
        -:  114: *   explicit Init(const Executor& ex) : ex_(ex) {}
        -:  115: *   executor_type get_executor() const noexcept { return ex_; }
        -:  116: *   template <typename CompletionHandler>
        -:  117: *     void operator()(CompletionHandler&& completion_handler) const;
        -:  118: * private:
        -:  119: *   Executor ex_; // exposition only
        -:  120: * }; @endcode
        -:  121: *
        -:  122: * The function call operator of @c Init:
        -:  123: *
        -:  124: * @li Obtains the handler's associated executor object @c ex1 of type @c Ex1 by
        -:  125: * performing @code auto ex1 = get_associated_executor(handler, ex); @endcode
        -:  126: *
        -:  127: * @li Obtains the handler's associated allocator object @c alloc by performing
        -:  128: * @code auto alloc = get_associated_allocator(handler); @endcode
        -:  129: *
        -:  130: * @li If <tt>execution::is_executor<Ex1>::value</tt> is true, constructs a
        -:  131: * function object @c f with a member @c executor_ that is initialised with
        -:  132: * <tt>prefer(ex1, execution::outstanding_work.tracked)</tt>, a member @c
        -:  133: * handler_ that is a decay-copy of @c completion_handler, and a function call
        -:  134: * operator that performs:
        -:  135: * @code auto a = get_associated_allocator(handler_);
        -:  136: * prefer(executor_, execution::allocator(a)).execute(std::move(handler_));
        -:  137: * @endcode
        -:  138: *
        -:  139: * @li If <tt>execution::is_executor<Ex1>::value</tt> is false, constructs a
        -:  140: * function object @c f with a member @c work_ that is initialised with
        -:  141: * <tt>make_work_guard(ex1)</tt>, a member @c handler_ that is a decay-copy of
        -:  142: * @c completion_handler, and a function call operator that performs:
        -:  143: * @code auto a = get_associated_allocator(handler_);
        -:  144: * work_.get_executor().dispatch(std::move(handler_), a);
        -:  145: * work_.reset(); @endcode
        -:  146: *
        -:  147: * @li If <tt>execution::is_executor<Ex>::value</tt> is true, performs
        -:  148: * @code prefer(
        -:  149: *     require(ex, execution::blocking.never),
        -:  150: *     execution::relationship.fork,
        -:  151: *     execution::allocator(alloc)
        -:  152: *   ).execute(std::move(f)); @endcode
        -:  153: *
        -:  154: * @li If <tt>execution::is_executor<Ex>::value</tt> is false, performs
        -:  155: * @code ex.post(std::move(f), alloc); @endcode
        -:  156: *
        -:  157: * @par Completion Signature
        -:  158: * @code void() @endcode
        -:  159: */
        -:  160:template <typename Executor,
        -:  161:    BOOST_ASIO_COMPLETION_TOKEN_FOR(void()) NullaryToken
        -:  162:      BOOST_ASIO_DEFAULT_COMPLETION_TOKEN_TYPE(Executor)>
      99*:  163:BOOST_ASIO_INITFN_AUTO_RESULT_TYPE_PREFIX(NullaryToken, void()) post(
        -:  164:    const Executor& ex,
        -:  165:    BOOST_ASIO_MOVE_ARG(NullaryToken) token
        -:  166:      BOOST_ASIO_DEFAULT_COMPLETION_TOKEN(Executor),
        -:  167:    typename constraint<
